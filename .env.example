# SimpleTES environment variables.
#
# Copy to `.env` and fill in what you need:  cp .env.example .env
# `.env` is gitignored; this template is not, so never put real secrets here.
# Values already present in the shell win — `.env` does not override them.

# ==================== LLM provider credentials ====================
# Any LiteLLM-supported provider works; set the keys for the ones you use.
# https://docs.litellm.ai/docs/providers

OPENAI_API_KEY=
# Custom / self-hosted OpenAI-compatible endpoint (vLLM, SGLang, gateways).
# Equivalent to passing --api-base on the CLI.
# OPENAI_API_BASE=http://127.0.0.1:8000/v1

# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Set to DEBUG to see the full LiteLLM request/response trace.
# LITELLM_LOG=DEBUG

# ==================== Hugging Face ====================
# transformers is used for token counting; point the cache at shared storage
# so every run does not re-download.
# HF_HOME=
# HF_ENDPOINT=https://hf-mirror.com

# ==================== Evaluation runtime ====================
# Evaluators run as subprocesses and inherit these. Keep BLAS single-threaded
# unless the task explicitly wants intra-op parallelism — otherwise concurrent
# evaluations oversubscribe the machine.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Global per-evaluation timeout override. Each evaluator ships its own
# TIMEOUT_SECONDS default; this wins when set.
# EVALUATOR_TIMEOUT_SECONDS=600

# CUDA_VISIBLE_DEVICES=0

# Shared-construction registry root used by scripts/evolve_db_registry.py.
# SIMPLETES_SHARED_ROOT=./shared_registry

# ==================== Task-family specific ====================
# Only needed when running that family — see datasets/<family>/README.md.

# --- ahc (Docker-based AtCoder heuristic contests) ---
# AHC_CACHE_DIR=datasets/ahc/cache
# AHC_DOCKER_IMAGE=yimjk/ale-bench:cpp20-202301
# AHC_CASE_WORKERS=6
# AHC_DOCKER_TIMEOUT=180

# --- numerical_tasks/lasso_path ---
# GENOMICS_DATA_DIR=

# --- qubit_routing ---
# QUBIT_ROUTING_RESULTS_DIR=
# QUBIT_ROUTING_SLOT_ROOT=/tmp/simpletes-qubit-routing-slots
# QUBIT_ROUTING_SLOT_COUNT=4

# --- zapbench (whole-brain forecasting) ---
# ZAPBENCH_SANDBOX_CUDA=
# ZAPBENCH_DISPATCH_MODE=slurm
# ZAPBENCH_STAGE_DIR=~/zap_dispatch

# --- astrodynamics ---
# IMPULSE_MGA_SAVE_TRAJECTORIES=1
